<%- include('header') %>

<div class="row justify-content-center">
    <div class="col-md-8 col-12">
        <h1 class="mb4">Новая заява</h1>

        <% if (typeof errors !== 'undefined' && errors.length) { %>
            <div class="alert alert-danger">
                <% errors.forEach(e => { %>
                    <div><%= e %></div>
                    <% }) %>
            </div>
        <% } %>
        <form method="POST" action="/create">
            <div class="mb-3">
                <label class="form-label">Помещение</label>
                <select class="form-select" name="room_id" required>
                <option value="" disabled selected>Выберите помещение</option>
                <% rooms.forEach(r => { %> 
                <option value="<%= r.id %>" <%= r.type %> - <%= r.name %> (<%= r.capacity %> чел.)</option>
                <% }) %> 
                </select>
             </div>

            <div class="mb-3">
                <label class="form-label">Дата начала конференции</label>
                <input type="date" class="form-control" name="date_start" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Способ оплаты</label>
                <select class="form-select" name="payment" required>
                    <option value="" disabled selected>Выберите способ оплаты</option>
                    <option value="При очном посищении">При очном посищении</option>
                    <option value="Перевод по СПБ">Перевод по СПБ</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">отправить заяву</button>
        </form>

        <p class="mt-3 text-center">
        <a href="/dasgboard">Вернутся к моим заявкам</a>
        </p>

    </div>
</div>

<%- include('footer') %>

