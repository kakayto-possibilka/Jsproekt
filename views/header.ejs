<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Конференции.РФ</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/favicon.ico">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">Конференции.РФ</a>
      <ul class="navbar-nav ms-auto">
        <% if (typeof session !== 'undefined' && session.userId) { %>
          <li class="nav-item">
            <a class="nav-link" href="/dashboard">Мои заявки</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/rooms">Помещения</a>
          </li>
          <% if (session.login === 'Conf2027') { %>
            <li class="nav-item">
              <a class="nav-link" href="/admin">Админ-панель</a>
            </li>
          <% } %>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Выйти (<%= session.fio %>)</a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/register">Регистрация</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login">Вход</a>
          </li>
        <% } %>
      </ul>
    </div>
  </nav>
  <div class="container mt-4 mb-5">